# ═══════════════════════════════════════════════════════════
# LinkedEye ITSM Platform — Environment Variables
# Copy to .env and fill in values
# ═══════════════════════════════════════════════════════════

# ── Core ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://linkedeye:LinkedEye@2026@localhost:5432/linkedeye?schema=public
REDIS_URL=redis://localhost:6379

# ── Authentication ──────────────────────────────────────
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Keycloak SSO (Optional) ────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=linkedeye
KEYCLOAK_CLIENT_ID=linkedeye-web
KEYCLOAK_CLIENT_SECRET=

# ── Observability ───────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
GRAFANA_URL=http://localhost:3001
GRAFANA_API_KEY=

# ── Slack ───────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=#incidents

# ── Twilio (SMS/Voice) ─────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── MSG91 (SMS — India) ────────────────────────────────
MSG91_API_KEY=
MSG91_SENDER_ID=LNKEYE

# ── Kaleyra (SMS/Voice — India) ────────────────────────
KALEYRA_API_KEY=
KALEYRA_SENDER_ID=

# ── Email (SMTP) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@linkedeye.santhira.com

# ── AI / LLM ───────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
HF_TEI_URL=http://localhost:8081
FLOWISE_URL=http://localhost:3002

# ── ServiceNow (Optional) ──────────────────────────────
SNOW_INSTANCE=
SNOW_USER=
SNOW_PASSWORD=

# ── Voice Server ────────────────────────────────────────
VOICE_SERVER_URL=http://localhost:8100
